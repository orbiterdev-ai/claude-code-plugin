{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "orbiter-approval-gate-permission-check",
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/orbiter-plugin-hook.cjs\" permission-check",
            "env": {
              "ORBITER_SERVER_URL": "https://api.orbiterdev.ai",
              "ORBITER_CREDENTIAL_PROFILE": "claude-code",
              "ORBITER_IDE_NAME": "Claude Code"
            },
            "timeout": 300000
          }
        ]
      }
    ]
  }
}
